# Supabase (Postgres + pgvector + Realtime + Auth)
# VITE_* are exposed to browser code (join code entry, waiting room, realtime progress).
# Vite does NOT expose unprefixed vars to the client, so these are required, not duplicates.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_KOBI_API_URL=http://localhost:8787
# Required only while apps/web still uses local demo classes like "class-1".
# Set this to a real classes.id UUID from Supabase so /api/sessions can satisfy its FK.
VITE_KOBI_DEMO_CLASS_ID=
# Server-only — never prefix with NEXT_PUBLIC_, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for apps/worker and packages/db (pg-boss queue tables, migrations).
# Supabase's project API URL/keys above are REST/Realtime endpoints, not a Postgres connection string —
# use the Supabase pooler (transaction mode) connection string here.
DATABASE_URL=

# Worker-owned HTTP API for audio upload/session endpoints.
PORT=8787
KOBI_API_CORS_ORIGINS=http://localhost:5173
AUDIO_BUCKET=audio-chunks
CURRICULUM_BUCKET=curriculum-sources

# Model providers used across ai-core stages (transcription / lesson-state / checkpoint / planner / verifier / variant)
GEMINI_API_KEY=
LESSON_STATE_PROVIDER=openai
LESSON_STATE_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Server-only Area C activity generation. Current OpenAI docs recommend gpt-5.5
# as the flagship starting point; use gpt-5.4-mini or gpt-5.4-nano when latency
# and cost matter more than maximum quality.
OPENAI_ACTIVITY_MODEL=gpt-5.5
OPENAI_ACTIVITY_RUBRIC_MODEL=
OPENAI_ACTIVITY_MAX_GENERATIONS_PER_SESSION=3

# Checkpoint gate (Understand -> Propose): OpenAI judges whether accumulated
# lesson_state material is sufficient + valid to generate an activity yet.
# Runs on its own timer (checkpoint-scheduler), independent of build-lesson-state.
CHECKPOINT_INTERVAL_MINUTES=10
OPENAI_CHECKPOINT_MODEL=gpt-5.4-mini

# Area A transcription provider switch: gemini | openai | elevenlabs
# If unset, ai-core defaults to the OpenAI transcription path.
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional ElevenLabs transcription path.
ELEVENLABS_API_KEY=
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v2

# Observability
LANGSMITH_API_KEY="your api key from langsmith"
LANGSMITH_TRACING=true;
