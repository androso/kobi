# Supabase (Postgres + pgvector + Realtime + Auth)
# VITE_* are exposed to browser code (join code entry, waiting room, realtime progress).
# Vite does NOT expose unprefixed vars to the client, so these are required, not duplicates.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only — never prefix with NEXT_PUBLIC_, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for apps/worker and packages/db (pg-boss queue tables, migrations).
# Supabase's project API URL/keys above are REST/Realtime endpoints, not a Postgres connection string —
# use the Supabase pooler (transaction mode) connection string here.
DATABASE_URL=

# Model providers used across ai-core stages (transcription / lesson-state / planner / verifier / variant)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server-only Area C activity generation. Current OpenAI docs recommend gpt-5.5
# as the flagship starting point; use gpt-5.4-mini or gpt-5.4-nano when latency
# and cost matter more than maximum quality.
OPENAI_ACTIVITY_MODEL=gpt-5.5
OPENAI_ACTIVITY_RUBRIC_MODEL=
OPENAI_ACTIVITY_MAX_GENERATIONS_PER_SESSION=3

# Observability
LANGSMITH_API_KEY=
